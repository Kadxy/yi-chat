# === App ===
NEXT_PUBLIC_APP_NAME=Yi Chat

# === LLM Provider API Keys ===
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=****

# === Database ===
POSTGRES_URL=postgres://user:password@localhost:5432/yi-chat

# === Auth ===
# Generate with: npx @better-auth/cli@latest secret
BETTER_AUTH_SECRET=
# For production, set to your domain (e.g., https://yi.chat)
BETTER_AUTH_URL=

# === Google OAuth (Optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same as GOOGLE_CLIENT_ID, exposed to client for Google One Tap
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Set to "1" to enable FedCM for Google One Tap (requires HTTPS + production domain)
NEXT_PUBLIC_ENABLE_FEDCM=0

# === File Storage (Cloudflare R2) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: public URL for file access
# R2_PUBLIC_URL=https://file.yi.chat
# Optional: Worker upload URL for regions where R2 S3 API is unreachable (e.g. China)
# R2_UPLOAD_WORKER_URL=https://upload.yi.chat
# Required if R2_UPLOAD_WORKER_URL is set: shared HMAC signing key with the Worker
# R2_UPLOAD_SECRET=

# === ALTCHA Captcha ===
ALTCHA_HMAC_KEY=
# ALTCHA_MAX_NUMBER=500000